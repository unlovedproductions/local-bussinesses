---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';

/**
 * Namecheap USD list prices checked 2026-09-26 against Namecheap TLD pages + live domain search
 * (CAD UI confirmed availability for aliscstore.*). +$0.20 ICANN fee applies on many TLDs at checkout.
 * Promo NEWCOM679: new-customer .com at $6.79 (non-premium). Renewals are higher than year-1 sale prices.
 */
const domains = [
  {
    name: 'aliscstore.com',
    tier: 'Recommended',
    register: 10.98,
    renew: 18.48,
    note: 'Closest match to Ali’s C Store. Best default.',
  },
  {
    name: 'alis-c-store.com',
    tier: 'Readable',
    register: 10.98,
    renew: 18.48,
    note: 'Same brand, easier to say aloud. Good redirect.',
  },
  {
    name: 'alis-cstore.com',
    tier: 'Readable',
    register: 10.98,
    renew: 18.48,
    note: 'No spaces in speech; still clear.',
  },
  {
    name: 'alisctobacco.com',
    tier: 'SEO-clear',
    register: 10.98,
    renew: 18.48,
    note: 'Signals tobacco retail for local search.',
  },
  {
    name: 'alissmokeshop.com',
    tier: 'SEO-clear',
    register: 10.98,
    renew: 18.48,
    note: 'Spells out the business type.',
  },
  {
    name: 'alissmoke.com',
    tier: 'Short',
    register: 10.98,
    renew: 18.48,
    note: 'Short brandable .com.',
  },
  {
    name: 'alis-c.com',
    tier: 'Short',
    register: 10.98,
    renew: 18.48,
    note: 'Vanity short. Harder for customers to guess.',
  },
  {
    name: 'aliscstore.net',
    tier: 'Alt TLD',
    register: 11.98,
    renew: 15.0,
    note: 'Backup if .com is later lost; prefer .com primary.',
  },
  {
    name: 'aliscstore.org',
    tier: 'Alt TLD',
    register: 8.48,
    renew: 18.98,
    note: 'Cheaper year 1; .org is less typical for retail.',
  },
  {
    name: 'aliscstore.shop',
    tier: 'Promo trap',
    register: 0.98,
    renew: 38.98,
    note: 'Cheap first year; renewal jumps hard — usually skip.',
  },
];

const fmt = (n: number) =>
  n.toLocaleString('en-US', { style: 'currency', currency: 'USD' });
---

<BaseLayout
  title="Pricing — Ali’s C Store"
  description="Website and local retail demo packages for Ali’s C Store, including Namecheap domain options."
  canonicalPath="/pricing/"
>
  <SiteHeader slot="header" />
  <div class="wrap">
    <span class="eyebrow">Proposal · Ali’s C Store</span>
    <h1>Choose a scope</h1>
    <p class="lead" style="max-width:40rem;">
      Packages for a local smoke / convenience shop website and optional connected POS &amp; inventory demo work.
      Domain registration is priced at Namecheap cost (checked Sep 2026) plus a flat setup fee.
    </p>
    <p><a class="btn btn-primary" href="/order">Fill out the order form</a></p>
    <p class="notice">
      Domain prices below are Namecheap first-year registration / renewal in USD. Add ~$0.20 ICANN fee where applicable.
      New-customer promo <strong>NEWCOM679</strong> can bring a .com to <strong>$6.79</strong> for year one. Prices change — confirm at checkout.
    </p>

    <h2 style="margin-top:2rem;">Package options</h2>
    <div class="cards pricing-cards">
      <article class="card">
        <div class="tag">Launch sooner</div>
        <h3>Essential</h3>
        <div class="price-lg">$1,300</div>
        <ul>
          <li>Custom storefront (home, shop, visit, contact)</li>
          <li>Mobile-friendly · demo-safe age notice</li>
          <li>One design direction · 1 revision round</li>
          <li>
            <strong>Domain:</strong> primary .com at Namecheap cost + $10 setup
            <br /><span class="muted">Typical: aliscstore.com ≈ {fmt(10.98)} yr1 → {fmt(18.48)} renew</span>
          </li>
        </ul>
      </article>

      <article class="card recommend">
        <div class="tag">Recommended</div>
        <h3>Standard</h3>
        <div class="price-lg">$2,100</div>
        <ul>
          <li>Everything in Essential</li>
          <li>Local SEO foundation (GBP checklist, NAP, visit page)</li>
          <li>Sales demo videos hosted on the site</li>
          <li>2 revision rounds · 2-week post-launch support</li>
          <li>
            <strong>Domain package:</strong> primary + one redirect
            <br /><span class="muted"
              >e.g. aliscstore.com + alis-c-store.com ≈ {fmt(10.98 + 10.98)} yr1 + $20 setup</span
            >
          </li>
        </ul>
      </article>

      <article class="card">
        <div class="tag">Connected retail</div>
        <h3>Full scope</h3>
        <div class="price-lg">$1,300 + $800</div>
        <ul>
          <li>Phase 1: Essential site + primary domain</li>
          <li>Phase 2: POS / inventory discovery &amp; connected demo (owner dashboard story)</li>
          <li>Both design versions kept on file</li>
          <li>
            <strong>Domain:</strong> same as Essential in Phase 1; optional second name in Phase 2
          </li>
        </ul>
      </article>
    </div>

    <h2 style="margin-top:2.5rem;">Domain options (Namecheap)</h2>
    <p>
      Pick one primary domain for the live site. Optional extras redirect to the primary. Registration billed at Namecheap
      cost; setup is $10 per domain pointed to hosting.
    </p>

    <div class="table-wrap">
      <table class="domain-table">
        <thead>
          <tr>
            <th>Domain</th>
            <th>Fit</th>
            <th>Year 1</th>
            <th>Renew</th>
            <th>Notes</th>
          </tr>
        </thead>
        <tbody>
          {
            domains.map((d) => (
              <tr class={d.tier === 'Recommended' ? 'row-rec' : undefined}>
                <td>
                  <code>{d.name}</code>
                </td>
                <td>{d.tier}</td>
                <td>{fmt(d.register)}</td>
                <td>{fmt(d.renew)}</td>
                <td>{d.note}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>

    <h3 style="margin-top:2rem;">Suggested domain bundles</h3>
    <div class="grid-2" style="margin-top:1rem;">
      <article class="card">
        <h3>Primary only</h3>
        <p><code>aliscstore.com</code></p>
        <p class="price-lg" style="font-size:1.5rem;">
          ≈ {fmt(10.98)} + $10 setup
        </p>
        <p class="muted">Included with Essential / Phase 1.</p>
      </article>
      <article class="card">
        <h3>Primary + readable redirect</h3>
        <p><code>aliscstore.com</code> + <code>alis-c-store.com</code></p>
        <p class="price-lg" style="font-size:1.5rem;">
          ≈ {fmt(21.96)} + $20 setup
        </p>
        <p class="muted">Included with Standard domain package.</p>
      </article>
      <article class="card">
        <h3>Primary + SEO-clear redirect</h3>
        <p><code>aliscstore.com</code> + <code>alisctobacco.com</code> or <code>alissmokeshop.com</code></p>
        <p class="price-lg" style="font-size:1.5rem;">
          ≈ {fmt(21.96)} + $20 setup
        </p>
        <p class="muted">Optional upgrade on any package.</p>
      </article>
      <article class="card">
        <h3>Skip</h3>
        <p><code>aliscstore.shop</code> and similar promo TLDs</p>
        <p class="muted">
          Year 1 looks cheap ({fmt(0.98)}); renewals often jump to ~{fmt(38.98)}+. Prefer .com.
        </p>
      </article>
    </div>

    <h2 style="margin-top:2.5rem;">Payment rhythm</h2>
    <div class="table-wrap">
      <table class="domain-table">
        <thead>
          <tr>
            <th>Option</th>
            <th>Total</th>
            <th>Structure</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td>A · Lump split</td>
            <td>$2,100</td>
            <td>50% at start ($1,050), 50% at launch ($1,050)</td>
          </tr>
          <tr>
            <td>B · 4 payments</td>
            <td>$2,100</td>
            <td>$525 × 4 — signing, midpoint, pre-launch, +30 days</td>
          </tr>
          <tr>
            <td>C · 6 payments</td>
            <td>$2,205</td>
            <td>$367.50 × 6 monthly from signing</td>
          </tr>
          <tr>
            <td>D · Phased</td>
            <td>$1,300 + $800</td>
            <td>Phase 1 now; Phase 2 when ready</td>
          </tr>
          <tr>
            <td>E · Essential only</td>
            <td>$1,300</td>
            <td>50/50, or $325 × 4</td>
          </tr>
        </tbody>
      </table>
    </div>

    <div class="grid-2" style="margin-top:2rem;">
      <article class="card">
        <h3>Included</h3>
        <ul>
          <li>Custom-coded, mobile-responsive site</li>
          <li>Hosting handoff / deploy to your domain</li>
          <li>Training walkthrough after launch</li>
          <li>Revisions per selected package</li>
        </ul>
      </article>
      <article class="card">
        <h3>Not included (pass-through / optional)</h3>
        <ul>
          <li>Hosting: $25–35/month</li>
          <li>Domain: Namecheap registration (above) + $10 setup each</li>
          <li>Maintenance after support window: $60–90/month</li>
          <li>Extra content edits: $50/hour</li>
          <li>Live POS vendor fees or paid API access</li>
        </ul>
      </article>
    </div>

    <p class="notice" style="margin-top:1.5rem;">
      Demo storefront reference: <a href="/">home</a> · <a href="/videos">videos</a> ·
      <a href="/how-it-works">POS story</a>. Smoke &amp; Supply branding in the interactive demo is fictional; Ali’s C Store
      is the real client name for domain and proposal copy.
    </p>
  </div>
  <SiteFooter slot="footer" />
</BaseLayout>

<style>
  .pricing-cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1.25rem;
    margin-top: 1rem;
  }
  .pricing-cards .tag {
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ember, #b54a2a);
    font-weight: 700;
  }
  .pricing-cards .recommend {
    border-color: var(--forest, #2f4a3c);
    box-shadow: 0 10px 30px rgba(47, 74, 60, 0.12);
  }
  .price-lg {
    font-family: Georgia, 'Noto Serif', serif;
    font-size: 2rem;
    color: var(--forest, #2f4a3c);
    margin: 0.35rem 0 0.75rem;
  }
  .muted {
    color: var(--muted, #6b726c);
    font-size: 0.9rem;
  }
  .table-wrap {
    overflow-x: auto;
    margin-top: 1rem;
  }
  .domain-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.95rem;
  }
  .domain-table th,
  .domain-table td {
    text-align: left;
    padding: 0.75rem 0.65rem;
    border-bottom: 1px solid var(--line, #d9d0c2);
    vertical-align: top;
  }
  .domain-table th {
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted, #6b726c);
  }
  .domain-table .row-rec {
    background: #fff8f4;
  }
  .domain-table code {
    font-size: 0.9rem;
  }
</style>
