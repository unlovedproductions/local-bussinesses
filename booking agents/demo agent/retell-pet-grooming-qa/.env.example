# Retell
RETELL_API_KEY=
RETELL_API_BASE=https://api.retellai.com
RECEPTIONIST_AGENT_ID=
RECEPTIONIST_PHONE_NUMBER=
QA_CALLER_AGENT_ID=
QA_OUTBOUND_NUMBER=
# phone | web  (web = Retell LLM simulation / web_call, no numbers; phone = Retell-to-Retell PSTN)
RETELL_CALL_MODE=web

# Judge (default: local Ollama)
JUDGE_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
JUDGE_MODEL=qwen2.5:14b-instruct-q5_K_M
# Optional OpenAI fallback if JUDGE_PROVIDER=openai
OPENAI_API_KEY=

# Budgets / safety (fail-closed defaults)
MAX_CALLS=3
MAX_CALL_DURATION_SECONDS=300
MAX_RUN_SPEND_USD=5
ALLOW_SANDBOX_WRITES=NO
ACK_TARGET_NUMBER=NO
SANDBOX_PROOF_PATH=config/sandbox_proof.json

# Optional assert / adapter endpoints
QA_ASSERT_URL=
# Local demo stub: python scripts/run_stub_adapter.py  →  http://127.0.0.1:8787
# Synthetic AUDIO/FAULT/DROP only — not real telephony or Cal.com breakage
TEST_ADAPTER_URL=http://127.0.0.1:8787

# Cal.com verification (discovered provider for Taft demo)
CALCOM_API_KEY=
CALCOM_API_BASE=https://api.cal.com/v2
CALCOM_API_VERSION=2024-08-13
CALCOM_EVENT_TYPE_ID=
CALCOM_SANDBOX_CALENDAR_ID=
CALCOM_TIMEZONE=America/Los_Angeles

# Paths
BUSINESS_CONFIG_PATH=config/business.json
QA_VARS_PATH=config/qa_vars.json
TEST_SETTINGS_PATH=config/test_settings.json
CASES_PATH=tests/cases.json
QA_RUNS_DIR=qa_runs
